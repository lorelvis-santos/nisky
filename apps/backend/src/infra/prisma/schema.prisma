generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  name          String?
  role          UserRole       @default(USER)
  avatarUrl     String?
  isActive      Boolean        @default(true)
  lastLoginAt   DateTime?
  refreshTokens RefreshToken[]
  tasks         Task[]
  subtasks      Subtask[]
  habits        Habit[]
  habitEntries  HabitEntry[]
  quickNotes    QuickNote[]
  pomodoroSessions PomodoroSession[]
  pomodoroSettings PomodoroSettings?
  timeBlockSettings TimeBlockSettings?
  journalSalt    Bytes?
  journalEntries JournalEntry[]
  notes          Note[]
  pushSubscriptions PushSubscription[]
  reminders      Reminder[]
  moodleAccounts MoodleAccount[]
  canvasAccounts CanvasAccount[]
  projects       Project[]
  timeBlocks     TimeBlock[]
  notificationSettings NotificationSettings?
  feedback      Feedback[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([role])
}

model Project {
  id         String      @id @default(uuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  color      String      @default("#303e51")
  isDefault  Boolean     @default(false)
  tasks      Task[]
  timeBlocks TimeBlock[]
  moodleAccounts MoodleAccount[]
  canvasAccounts CanvasAccount[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model TimeBlock {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  name      String?
  dayOfWeek Int
  startMin  Int
  endMin    Int
  isActive  Boolean  @default(true)
  repeatEveryWeeks Int       @default(1)
  repeatEndsAt     DateTime?
  remindBeforeMin  Int        @default(0)
  lastRemindNotifiedAt DateTime?
  lastStartNotifiedAt   DateTime?
  lastEndWarnNotifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, dayOfWeek, isActive])
  @@index([projectId])
}

model NotificationSettings {
  userId               String   @id
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  morningDigest        Boolean  @default(true)
  taskDueReminders     Boolean  @default(true)
  integrationNews      Boolean  @default(true)
  integrationErrors    Boolean  @default(true)
  timeBlockReminders   Boolean  @default(true)
  updatedAt            DateTime @updatedAt
}

model TimeBlockSettings {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayStartMin Int      @default(360)
  dayEndMin   Int      @default(1380)
  updatedAt   DateTime @updatedAt
}

model Task {
  id                 String       @id @default(uuid())
  userId             String
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title              String
  description        String?
  status             TaskStatus   @default(PENDING)
  priority           TaskPriority @default(NORMAL)
  dueDate            DateTime?
  completedAt        DateTime?
  order              Int          @default(0)
  source             TaskSource   @default(MANUAL)
  sourceRef          String?
  projectId          String?
  project            Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  archivedAt         DateTime?
  lastDueWarnedAt    DateTime?
  recurrenceType        TaskRecurrenceType?
  recurrenceInterval    Int                 @default(1)
  recurrenceDaysOfWeek  Int[]               @default([])
  recurrenceDayOfMonth  Int?
  recurrenceEndsAt      DateTime?
  recurrenceParentId    String?
  recurrenceParent      Task?               @relation("TaskRecurrence", fields: [recurrenceParentId], references: [id], onDelete: SetNull)
  recurrenceOccurrences Task[]              @relation("TaskRecurrence")
  subtasks           Subtask[]
  pomodoroEstimate   Int          @default(0)
  pomodoroCount      Int          @default(0)
  pomodoroSessions   PomodoroSession[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([userId, priority])
  @@index([userId, source, sourceRef])
  @@index([userId, recurrenceType])
  @@index([recurrenceParentId])
  @@unique([userId, source, sourceRef])
}

enum TaskSource {
  MANUAL
  MOODLE
  CANVAS
}

model Subtask {
  id          String    @id @default(uuid())
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  completed   Boolean   @default(false)
  completedAt DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([taskId])
  @@index([userId])
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum PomodoroPhase {
  WORK
  SHORT_BREAK
  LONG_BREAK
}

enum PomodoroSessionStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

model PomodoroSession {
  id             String                 @id @default(uuid())
  userId         String
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId         String?
  task           Task?                  @relation(fields: [taskId], references: [id], onDelete: SetNull)
  phase          PomodoroPhase
  status         PomodoroSessionStatus  @default(ACTIVE)
  plannedSec     Int
  actualSec      Int?
  cycleIndex     Int                    @default(1)
  startedAt      DateTime               @default(now())
  pausedAt       DateTime?
  totalPausedSec Int                    @default(0)
  endedAt        DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([userId, startedAt])
  @@index([userId, status])
  @@index([userId, taskId])
}

model PomodoroSettings {
  userId        String   @id
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workSec       Int      @default(1500)
  shortBreakSec Int      @default(300)
  longBreakSec  Int      @default(900)
  cyclesPerLong Int      @default(4)
  autoCycle     Boolean  @default(false)
  soundEnabled  Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

enum HabitFrequency {
  DAILY
  WEEKLY
}

model Habit {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  color       String?
  frequency   HabitFrequency @default(DAILY)
  targetDays  Int            @default(7)
  archived    Boolean        @default(false)
  entries     HabitEntry[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([userId, archived])
}

model HabitEntry {
  id        String   @id @default(uuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  completed Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([habitId, date])
  @@index([userId, date])
  @@index([habitId, date])
}

enum QuickNoteStatus {
  INBOX
  ARCHIVED
}

model QuickNote {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  status    QuickNoteStatus @default(INBOX)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([userId, status])
  @@index([userId, createdAt])
}

model JournalEntry {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  contentCipher  Bytes
  iv             Bytes
  authTag        Bytes
  classification String?
  tags           String[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, createdAt])
}

model Note {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String
  category  String?
  tags      String[]
  pinned    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([userId, category])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([key])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, endpoint])
  @@index([userId])
}

enum ReminderRepeatType {
  DAILY
  WEEKLY
  MONTHLY
}

enum TaskRecurrenceType {
  DAILY
  WEEKLY
  MONTHLY
}

model Reminder {
  id               String             @id @default(uuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String             @db.VarChar(200)
  body             String?
  triggerAt        DateTime
  timezone         String             @default("America/Bogota")
  repeatType       ReminderRepeatType?
  repeatInterval   Int                @default(1)
  repeatDaysOfWeek Int[]
  repeatDayOfMonth Int?
  payload          Json?
  isActive         Boolean            @default(true)
  sentAt           DateTime?
  resolvedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([isActive, triggerAt])
  @@index([userId, isActive, triggerAt])
  @@index([userId, triggerAt])
}

model MoodleAccount {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain       String
  username     String
  tokenCipher  String
  tokenIv      String
  tokenAuthTag String
  service      String   @default("moodle_mobile_app")
  enabled      Boolean  @default(true)
  lastSyncAt   DateTime?
  syncError    String?
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, domain])
  @@index([userId])
}

enum FeedbackCategory {
  BUG
  IDEA
  IMPROVEMENT
  OTHER
}

enum FeedbackStatus {
  NEW
  REVIEWING
  RESOLVED
}

model Feedback {
  id           String           @id @default(uuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     FeedbackCategory
  message      String           @db.Text
  contactEmail String?
  status       FeedbackStatus   @default(NEW)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model CanvasAccount {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain       String
  username     String   @default("")
  tokenCipher  String
  tokenIv      String
  tokenAuthTag String
  enabled      Boolean  @default(true)
  lastSyncAt   DateTime?
  syncError    String?
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, domain])
  @@index([userId])
}
