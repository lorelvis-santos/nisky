# Keep the browser API same-origin so the refresh cookie stays on the panel.
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_PUBLIC_SIGNUP=true
# Internal URL reachable by the Next.js server, not by the browser.
BACKEND_INTERNAL_URL=http://localhost:4000
# Public OAuth issuer. It must match the backend value exactly.
OAUTH_ISSUER_URL=http://localhost:3000
# Public backend URL used by the browser for Socket.IO.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
