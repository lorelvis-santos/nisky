NODE_ENV=development
PORT=4000
# Exact browser origin(s), without a trailing slash; use | between origins.
FRONTEND_URL=http://localhost:3000

DATABASE_URL=postgresql://admin:password@localhost:5433/nisky?schema=public

# Redis (presencia en chat). En prod usar la URL interna del proveedor.
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-with-a-long-access-secret-at-least-32-chars
# Generate once with: openssl rand -base64 32. Keep it stable across deploys;
# changing it makes persisted integration tokens impossible to decrypt.
APP_ENCRYPTION_KEY=replace-with-a-stable-encryption-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
PUBLIC_SIGNUP=true

INITIAL_ADMIN_EMAIL=admin@nisky.local
INITIAL_ADMIN_PASSWORD=admin123456

STORAGE_IMAGE_DRIVER=s3
STORAGE_VIDEO_DRIVER=s3
STORAGE_DOCUMENT_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_NAME=nisky-bucket
S3_ACCESS_KEY=nisky_access_key
S3_SECRET_KEY=nisky_secret_key_change_me
S3_PUBLIC_URL=http://localhost:9000/nisky-bucket
S3_FORCE_PATH_STYLE=true

EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@nisky.local

VAPID_SUBJECT=mailto:admin@nisky.local
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Cliente Moodle primario: wreq-js con fingerprint Chrome; si falla el transporte
# o el módulo nativo no carga, usa el cliente curl_cffi de respaldo.
# MOODLE_WREQ_BROWSER=chrome_149
# Proxy HTTPS autorizado y con IP permitida por Moodle/Cloudflare (opcional).
# MOODLE_PROXY_URL=http://proxy.example.com:8080
# Cliente curl_cffi de respaldo (opcional). Por defecto usa scripts/.venv/bin/python del repo.
# MOODLE_PYTHON_BIN=/ruta/al/python
# MOODLE_PYTHON_SCRIPT=/ruta/al/moodle_fetch.py
